// Prisma schema for Business Dashboard ERP (Kiros-inspired)
// Greek e-invoicing + SME management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          Role      @default(OWNER)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  OWNER
  ACCOUNTANT
  EMPLOYEE
}

model Company {
  id            String     @id @default(cuid())
  name          String
  afm           String     @unique // ΑΦΜ
  doy           String?    // ΔΟΥ
  address       String?
  city          String?
  postalCode    String?
  phone         String?
  email         String?
  aadeConnected Boolean    @default(false)
  aadeUsername  String?
  users         User[]
  customers     Customer[]
  products      Product[]
  documents     Document[]
  projects      Project[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Customer {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  name        String
  afm         String?
  email       String?
  phone       String?
  address     String?
  city        String?
  documents   Document[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId])
  @@index([afm])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  vatRate     Int      @default(24) // 0, 6, 13, 24
  type        ProductType @default(SERVICE)
  unit        String   @default("τεμ")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

enum ProductType {
  PRODUCT
  SERVICE
}

model Document {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  type          DocumentType
  series        String?
  number        Int?
  fullNumber    String?        // e.g. ΤΙΜ-2026-0142
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  netAmount     Decimal        @db.Decimal(12, 2)
  vatAmount     Decimal        @db.Decimal(12, 2)
  totalAmount   Decimal        @db.Decimal(12, 2)
  currency      String         @default("EUR")
  status        DocumentStatus @default(DRAFT)
  paymentStatus PaymentStatus  @default(UNPAID)
  mark          String?        // AADE MARK
  uid           String?        // AADE UID
  description   String?
  notes         String?
  lines         DocumentLine[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([issueDate])
  @@index([mark])
}

enum DocumentType {
  INVOICE_SALE          // 1.1
  INVOICE_SERVICE       // 2.1
  DELIVERY_NOTE         // 9.3
  RETAIL_RECEIPT        // 11.1
  SERVICE_RECEIPT       // 11.2
  EXPENSE               // Incoming
}

enum DocumentStatus {
  DRAFT
  ISSUED
  CANCELLED
  SENT_TO_AADE
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model DocumentLine {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  vatRate     Int
  netAmount   Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
}

model Project {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  customerId  String?
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}
